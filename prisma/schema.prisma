generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id                      String       @id @default(cuid())
  siteName                String
  title                   String
  description             String?
  siteUrl                 String?
  logo                    String?
  favicon                 String?
  ogImage                 String?
  metaTitle               String?
  metaDescription         String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  playerNoticeDescription String?
  playerNoticeTitle       String?
  telegramDescription     String?
  telegramTitle           String?
  googleAnalyticsId       String?
  googleSiteVerification  String?
  hero                    HeroSetting?
  adLinks                 AdLink[]
  footerItems             FooterItem[]
  navbarItems             NavbarItem[]
  socialLinks             SocialLink[]
}

model HeroSetting {
  id                  String      @id @default(cuid())
  siteId              String      @unique
  badge               String?
  title               String?
  subtitle            String?
  year                String?
  description         String?
  primaryButtonText   String?
  primaryButtonUrl    String?
  secondaryButtonText String?
  secondaryButtonUrl  String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  site                SiteSetting @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model AdLink {
  id            String      @id @default(uuid())
  name          String
  url           String
  order         Int         @default(0)
  siteSettingId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  position      AdPosition  @default(body)
  isActive      Boolean     @default(true)
  siteSetting   SiteSetting @relation(fields: [siteSettingId], references: [id], onDelete: Cascade)

  @@index([siteSettingId])
  @@map("ad_links")
}

model SocialLink {
  id            String         @id @default(uuid())
  name          String
  platform      SocialPlatform
  url           String
  siteSettingId String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  siteSetting   SiteSetting    @relation(fields: [siteSettingId], references: [id], onDelete: Cascade)

  @@index([siteSettingId])
  @@map("social_links")
}

model NavbarItem {
  id            String      @id @default(uuid())
  name          String
  url           String
  order         Int         @default(0)
  siteSettingId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  siteSetting   SiteSetting @relation(fields: [siteSettingId], references: [id], onDelete: Cascade)

  @@index([siteSettingId])
  @@map("navbar_items")
}

model FooterItem {
  id            String      @id @default(uuid())
  name          String
  url           String
  order         Int         @default(0)
  siteSettingId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  siteSetting   SiteSetting @relation(fields: [siteSettingId], references: [id], onDelete: Cascade)

  @@index([siteSettingId])
  @@map("footer_items")
}

model AdWidget {
  id         String           @id @default(uuid())
  name       String
  htmlCode   String?
  scriptCode String?
  position   AdWidgetPosition
  order      Int              @default(0)
  isActive   Boolean          @default(true)
  height     Int              @default(90)
  maxWidth   String           @default("md")
  mobileOnly Boolean          @default(true)
  showClose  Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([position, isActive])
  @@map("ad_widgets")
}

model Article {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  metaDescription String?
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  poster          String?
  thumbnail       String?
  status          StatusArticle @default(publish)
  uploadBy        String        @default("X")
  categories      Category[]    @relation("ArticleToCategory")
  streams         Stream[]      @relation("ArticleToStream")

  @@index([createdAt])
  @@map("articles")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[] @relation("ArticleToCategory")

  @@map("categories")
}

model Stream {
  id               String     @id @default(uuid())
  name             String
  type             StreamType
  url              String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  drmId            String?
  drmKey           String?
  directLink       String?    @default("")
  directLinkActive Boolean    @default(false)
  isActive         Boolean    @default(true)
  articles         Article[]  @relation("ArticleToStream")

  @@map("streams")
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

enum AdPosition {
  head
  body
}

enum AdWidgetPosition {
  head
  body
  article
  sidebar
  floating
  footer
}

enum SocialPlatform {
  telegram
  facebook
  instagram
  twitter
  youtube
  tiktok
  pinterest
}

enum StatusArticle {
  publish
  draft
}

enum StreamType {
  hls
  dash
}
